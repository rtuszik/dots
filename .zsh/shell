# [B]rew [I]nstall [P]ackage
function bip() {
  local inst=$(brew search "$@" | fzf -m)

  if [[ $inst ]]; then
    for prog in $(echo $inst);
    do; brew install $prog; done;
  fi

  if [[ "$1" == oci://* ]]; then
    helm show values "${1}" | bat -l yaml
  else
    if [[ $# -lt 2 ]]; then
      echo "Error: HTTP repo requires both <chart> and <repo-url>" >&2
      return 1
git() {
  if [[ $1 == clone ]]; then
    shift
    # collect only the non-flag args (the URL, normally)
    local args=("$@")
    local positionals=(${args:#-*})

    if (( ${#positionals} == 1 )); then
      # simple `git clone <url>` — the case you'll fat-finger
      ghq get "$@"
    else
      # custom dest dir or flags ghq won't understand: let real git handle it
      print -u2 "git: passing through to real clone (ghq can't take a dest/these flags)"
      command git clone "$@"
    fi
  else
    command git "$@"
  fi
}

function krew-install() {
  local plugin

  plugin=$(
    kubectl krew search |
      awk 'NR > 1 {print $1}' |
      fzf \
        --height=80% \
        --layout=reverse \
        --border \
        --prompt='krew> ' \
        --preview='kubectl krew info {}' \
        --preview-window='right:60%:wrap'
  ) || return

  [[ -z "$plugin" ]] && return

  kubectl krew info "$plugin"

  if gum confirm "Install $plugin?"; then
    kubectl krew install "$plugin"
  fi
}


